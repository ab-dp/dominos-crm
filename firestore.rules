rules_version = '2';

// כללי האבטחה של המערכת (אפיון סעיף 11 ו-13). ההרשאות נאכפות כאן, בצד השרת – לא רק בממשק.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // מנהל המערכת הקבוע – תמיד יכול להיכנס ולאשר. נדרש מייל מאומת (כניסה עם Google).
    function bootEmail() { return 'alonberger16@gmail.com'; }
    function isBoot() {
      return signedIn() && request.auth.token.email == bootEmail() && request.auth.token.email_verified == true;
    }

    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(myPath()) && get(myPath()).data.status == 'active'; }
    function isAdmin() { return isBoot() || (isActive() && get(myPath()).data.role == 'admin'); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // בקשת הצטרפות: רק לעצמך, במצב "ממתין" ובתפקיד "משתמש". מנהל המערכת הקבוע נוצר ישר כפעיל.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'user')
          || (isBoot() && request.resource.data.status == 'active' && request.resource.data.role == 'admin')
        );

      allow update: if
        // משתמש על עצמו: רק זמן כניסה אחרונה
        (request.auth.uid == uid && onlyChanges(['lastLogin']))
        // משתמש שנמחק ונכנס שוב: בקשה חדשה במצב "ממתין"
        || (request.auth.uid == uid
            && resource.data.status == 'deleted'
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'user'
            && onlyChanges(['status', 'role', 'requestedAt', 'name', 'lastLogin', 'rejectReason']))
        // מנהל: הכל – חוץ מהשבתה, מחיקה או הורדת תפקיד של מנהל המערכת הקבוע
        || (isAdmin() && !(resource.data.email == bootEmail()
            && (request.resource.data.status != 'active' || request.resource.data.role != 'admin')));

      // אין מחיקה פיזית – רק מצב "נמחק"
      allow delete: if false;
    }

    // יומן פעולות: אפשר רק להוסיף. אף אחד, כולל מנהל, לא עורך ולא מוחק.
    match /auditLog/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isActive();
      allow update, delete: if false;
    }

    // ---------- סניפים ואשכולות (אפיון 6.10): כל משתמש פעיל מוסיף ועורך. אין מחיקה – רק "לא פעיל". ----------
    function validName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 60; }
    function stampedByMe(d) { return d.updatedBy == request.auth.uid; }
    function clusterExists(id) { return id is string && exists(/databases/$(database)/documents/clusters/$(id)); }
    function validPhone(p) { return p is string && p.size() <= 10 && (p.size() == 0 || p.matches('^0[0-9]{8,9}$')); }
    function validBranchNo(n) { return n is string && n.size() <= 10 && (n.size() == 0 || n.matches('^[0-9]+$')); }

    match /clusters/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /branches/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && validBranchNo(request.resource.data.get('number', ''))
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'clusterId', 'number', 'phone', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && validBranchNo(request.resource.data.get('number', ''))
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'clusterId', 'number', 'phone', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // ---------- לקוחות (אפיון 6.5, 12, 13) ----------
    // שדות טקסט חופשי לא מקבלים רצף של 13 ספרות ומעלה – כדי שאיש לא ירשום מספר כרטיס אשראי
    function noCard(s) { return s is string && s.size() <= 2000 && !s.matches('.*[0-9]{13,}.*'); }
    function taxPath(t) { return /databases/$(database)/documents/taxIds/$(t); }
    function validCustomer(d, cid) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['regular', 'occasional']
        && d.status in ['active', 'inactive', 'merged']
        && d.taxId is string && d.taxId.size() <= 9
        && (d.taxId == '' || (existsAfter(taxPath(d.taxId)) && getAfter(taxPath(d.taxId)).data.customerId == cid))
        && d.paymentMethod is string
        && d.accountPhone is string && d.accountPhone.size() <= 10
        && d.poRequired is bool
        && noCard(d.instructions) && noCard(d.billingInstructions) && noCard(d.get('priceNote', ''))
        && d.contacts is list && d.contacts.size() <= 30
        && d.addresses is list && d.addresses.size() <= 30
        && d.customPrices is list && d.customPrices.size() <= 500;
    }

    match /customers/{cid} {
      allow read: if isActive();
      allow create: if isActive()
        && validCustomer(request.resource.data, cid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive()
        && validCustomer(request.resource.data, cid)
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']);
      allow delete: if false;

      match /activity/{aid} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['note', 'call', 'followup']
          && noCard(request.resource.data.text) && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }

    // ח.פ ייחודי: מסמך לכל ח.פ. יצירה כפולה נכשלת (נחשבת עדכון, ועדכון אסור).
    match /taxIds/{taxId} {
      allow read: if isActive();
      allow create: if isActive()
        && taxId.matches('^[0-9]{5,9}$')
        && request.resource.data.customerId is string
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.taxId == taxId;
      // שחרור ח.פ רק כשהלקוח שלו עובר לח.פ אחר באותה פעולה
      allow delete: if isActive()
        && getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.taxId != taxId;
      allow update: if false;
    }

    // ---------- מחירונים (אפיון 6.7) ----------
    match /priceLists/{pid} {
      allow read: if isActive();
      allow create, update: if isActive()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['shared', 'unique']
        && request.resource.data.active is bool
        && request.resource.data.items is list && request.resource.data.items.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------- הזמנות (אפיון 6.1–6.4, 12) ----------
    // מספר הזמנה רץ: counters/orders.next. יצירת הזמנה N מותרת רק אם המונה עמד על N ועולה ל-N+1
    // באותה פעולה – כך אין שני מספרים זהים גם כששני משתמשים שומרים באותה שנייה.
    function counterPath() { return /databases/$(database)/documents/counters/orders; }
    function orderPath(n) { return /databases/$(database)/documents/orders/$(string(n)); }
    function opt(d, k) { return d.get(k, ''); }
    function validOrder(d) {
      return d.customerId is string && d.customerId.size() > 0
        && existsAfter(/databases/$(database)/documents/customers/$(d.customerId))
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && (d.time == '' || d.time.matches('^[0-9]{2}:[0-9]{2}$'))
        && d.branchId is string && (d.branchId == '' || exists(/databases/$(database)/documents/branches/$(d.branchId)))
        && d.branchName is string && d.branchName.size() <= 60
        && d.amount is number && d.amount >= 0 && d.amount < 1000000
        && d.status in ['new', 'pending_customer', 'approved', 'delivered', 'partial', 'cancelled']
        && d.payment in ['pending', 'paid', 'failed', 'cancelled']
        && d.method is string && d.method.size() <= 40
        && d.delivery in ['delivery', 'pickup']
        && d.poRequired is bool
        && d.items is list && d.items.size() <= 200
        && d.notes is list && d.notes.size() <= 200
        && noCard(opt(d, 'instructions')) && noCard(opt(d, 'note')) && noCard(opt(d, 'billingNote'))
        && noCard(opt(d, 'address')) && noCard(opt(d, 'poNumber')) && noCard(opt(d, 'qNumber')) && noCard(opt(d, 'contents')) && noCard(opt(d, 'channel'))
        && noCard(opt(d, 'partialNote')) && noCard(opt(d, 'cancelReason')) && noCard(opt(d, 'cancelNote'))
        && noCard(opt(d, 'contactName')) && noCard(opt(d, 'instructions'))
        && (!('calcAmount' in d) || (d.calcAmount is number && d.calcAmount >= 0))
        && (!('deliveryFee' in d) || (d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee < 10000))
        && d.keys().size() <= 70;
    }

    // ---------- סגירת חודש (אפיון 7) ----------
    function monthPath(date) { return /databases/$(database)/documents/months/$(date[0:7]); }
    function monthLocked(date) { return exists(monthPath(date)) && get(monthPath(date)).data.status == 'locked'; }
    function lockFixOk(d) {
      return d.get('postCloseFix', null) is map && d.postCloseFix.reason is string
        && d.postCloseFix.reason.size() >= 3 && d.postCloseFix.reason.size() <= 500 && !d.postCloseFix.reason.matches('.*[0-9]{13,}.*')
        && d.postCloseFix.at == request.time;
    }

    match /months/{ym} {
      allow read: if isActive();
      allow create: if isActive() && ym.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.status in ['open', 'locked'] && request.resource.data.updatedBy == request.auth.uid;
      // חודש נעול לא משתנה; פתיחה מחדש – רק מנהל, עם סיבה
      allow update: if isActive() && request.resource.data.status in ['open', 'locked'] && request.resource.data.updatedBy == request.auth.uid
        && (resource.data.status != 'locked'
            || (request.resource.data.status == 'open' && isAdmin()
                && request.resource.data.reopenReason is string && request.resource.data.reopenReason.size() >= 3));
      allow delete: if false;
    }

    match /orders/{oid} {
      allow read: if isActive();
      allow create: if isActive()
        && validOrder(request.resource.data)
        && !monthLocked(request.resource.data.date)
        && request.resource.data.number == int(oid)
        && (exists(counterPath())
              ? get(counterPath()).data.next == request.resource.data.number
              : request.resource.data.number == 1001)
        && getAfter(counterPath()).data.next == request.resource.data.number + 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isActive()
        && validOrder(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['number', 'createdAt', 'createdBy', 'createdByUid'])
        // חודש נעול: שינוי סכום/תאריך/סטטוס/תשלום רק עם סיבה טרייה (אפיון 7)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'qAmount', 'calcAmount', 'deliveryFee', 'date', 'status', 'payment'])
            || (!monthLocked(resource.data.date) && !monthLocked(request.resource.data.date))
            || lockFixOk(request.resource.data));
      // מחיקה לגמרי – רק מנהל מערכת, ולא בחודש נעול (ביומן נשארת רשומה עם הסיבה)
      allow delete: if isAdmin() && !monthLocked(resource.data.date);

      // הערות פנימיות: אפשר רק להוסיף. אף אחד, כולל מנהל, לא עורך ולא מוחק.
      match /notes/{nid} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['text', 'by', 'byName', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && noCard(request.resource.data.text);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // "פותח כרגע": כל משתמש כותב ומוחק רק את הרשומה של עצמו
      match /viewers/{vid} {
        allow read: if isActive();
        allow create, update: if isActive() && vid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 120;
        allow delete: if (isActive() && vid == request.auth.uid) || isAdmin();
      }
    }

    match /counters/orders {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 1002
        && existsAfter(orderPath(1001));
      allow update: if isActive()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1
        && existsAfter(orderPath(resource.data.next));
      allow delete: if false;
    }

    // ---------- מסמכי הזמנה: הקובץ נשמר בתוך Firestore בחלקים (בלי Storage בתשלום). אין עריכה ואין מחיקה. ----------
    match /orderDocs/{did} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.by == request.auth.uid
        // מסמך של הזמנה (ההזמנה קיימת) או מסמך קבוע של לקוח (הלקוח קיים)
        && (('orderId' in request.resource.data
              && request.resource.data.orderId is string
              && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)))
            || (!('orderId' in request.resource.data)
              && request.resource.data.customerId is string
              && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))))
        && request.resource.data.get('kindLabel', '') is string && request.resource.data.get('kindLabel', '').size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.type in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp']
        && request.resource.data.size is int && request.resource.data.size <= 2097152
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 4;
      allow update: if false;
      allow delete: if isAdmin();

      match /chunks/{ci} {
        allow read: if isActive();
        allow create: if isActive()
          && getAfter(/databases/$(database)/documents/orderDocs/$(did)).data.by == request.auth.uid
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 720000;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- לקוחות פוטנציאליים (אפיון 19.1, 19.5): כל משתמש פעיל רואה ועורך. אין מחיקה. ----------
    // ליד פתוח חייב צעד הבא עם תאריך; "לא רלוונטי" חייב סיבה; "לקוח פעיל" חייב קישור ללקוח קיים, ולא חוזר אחורה.
    function validStep(s) { return s is map && s.text is string && s.text.size() > 0 && noCard(s.text) && s.due is string && s.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validLead(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.stage in ['new', 'contacted', 'proposal', 'trial', 'won', 'lost']
        && d.taxId is string && d.taxId.size() <= 9
        && d.contacts is list && d.contacts.size() <= 20
        && d.tags is list && d.tags.size() <= 20
        && noCard(d.get('notes', '')) && noCard(d.get('area', '')) && noCard(d.get('lostNote', ''))
        && d.potentialOrders is number && d.potentialAmount is number && d.size is number
        && d.ownerUid is string
        && (d.stage in ['won', 'lost'] || validStep(d.nextStep))
        && (d.stage != 'lost' || (d.lostReason is string && d.lostReason.size() > 0))
        && (d.stage != 'won' || (d.customerId is string && existsAfter(/databases/$(database)/documents/customers/$(d.customerId))))
        && d.keys().size() <= 40;
    }
    match /leads/{lid} {
      allow read: if isActive();
      allow create: if isActive()
        && validLead(request.resource.data)
        && request.resource.data.stage in ['new', 'contacted', 'proposal', 'trial']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isActive()
        && validLead(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && (resource.data.stage != 'won' || (request.resource.data.stage == 'won' && request.resource.data.customerId == resource.data.customerId));
      allow delete: if false;

      // תיעוד פעילות: אפשר רק להוסיף
      match /activity/{aid} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['call', 'whatsapp', 'email', 'meeting', 'sample', 'note', 'stage']
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && noCard(request.resource.data.text)
          && noCard(request.resource.data.get('asked', '')) && noCard(request.resource.data.get('objections', '')) && noCard(request.resource.data.get('outcome', ''));
        allow update, delete: if false;
      }
    }

    // ---------- משימות מעקב: נוצרות מתיק לקוח או מצעד הבא של ליד. אין מחיקה – רק סימון בוצע (והחזרה), עם שם המסמן. ----------
    match /tasks/{tid} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.done == false
        && request.resource.data.customerId is string
        && ((request.resource.data.get('leadId', null) is string
              && existsAfter(/databases/$(database)/documents/leads/$(request.resource.data.leadId)))
            || exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId)))
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && noCard(request.resource.data.text)
        && request.resource.data.due is string && request.resource.data.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow update: if isActive()
        && onlyChanges(['done', 'doneBy', 'doneByName', 'doneAt'])
        && request.resource.data.done is bool
        && (request.resource.data.done == false || request.resource.data.doneBy == request.auth.uid);
      allow delete: if false;
    }

    // ---------- הגדרות: רשימות וספים. כולם קוראים, רק מנהל משנה. ----------
    match /settings/{key} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // כל השאר חסום עד שייבנה
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
