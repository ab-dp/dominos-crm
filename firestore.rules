rules_version = '2';

// שלב 0: המסד נעול לגמרי. אף אחד לא קורא ולא כותב.
// בשלב 2 נוסף אוסף users עם מצבי חשבון, ומנהל המערכת הקבוע:
//   alonberger16@gmail.com
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
