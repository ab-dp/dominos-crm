rules_version = '2';

// כללי האבטחה של המערכת (אפיון סעיף 11 ו-13). ההרשאות נאכפות כאן, בצד השרת – לא רק בממשק.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // מנהל המערכת הקבוע – תמיד יכול להיכנס ולאשר. נדרש מייל מאומת (כניסה עם Google).
    function bootEmail() { return 'alonberger16@gmail.com'; }
    function isBoot() {
      return signedIn() && request.auth.token.email == bootEmail() && request.auth.token.email_verified == true;
    }

    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(myPath()) && get(myPath()).data.status == 'active'; }
    function isAdmin() { return isBoot() || (isActive() && get(myPath()).data.role == 'admin'); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // בקשת הצטרפות: רק לעצמך, במצב "ממתין" ובתפקיד "משתמש". מנהל המערכת הקבוע נוצר ישר כפעיל.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'user')
          || (isBoot() && request.resource.data.status == 'active' && request.resource.data.role == 'admin')
        );

      allow update: if
        // משתמש על עצמו: רק זמן כניסה אחרונה
        (request.auth.uid == uid && onlyChanges(['lastLogin']))
        // משתמש שנמחק ונכנס שוב: בקשה חדשה במצב "ממתין"
        || (request.auth.uid == uid
            && resource.data.status == 'deleted'
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'user'
            && onlyChanges(['status', 'role', 'requestedAt', 'name', 'lastLogin', 'rejectReason']))
        // מנהל: הכל – חוץ מהשבתה, מחיקה או הורדת תפקיד של מנהל המערכת הקבוע
        || (isAdmin() && !(resource.data.email == bootEmail()
            && (request.resource.data.status != 'active' || request.resource.data.role != 'admin')));

      // אין מחיקה פיזית – רק מצב "נמחק"
      allow delete: if false;
    }

    // יומן פעולות: אפשר רק להוסיף. אף אחד, כולל מנהל, לא עורך ולא מוחק.
    match /auditLog/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isActive();
      allow update, delete: if false;
    }

    // ---------- סניפים ואשכולות (אפיון 6.10): כל משתמש פעיל מוסיף ועורך. אין מחיקה – רק "לא פעיל". ----------
    function validName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 60; }
    function stampedByMe(d) { return d.updatedBy == request.auth.uid; }
    function clusterExists(id) { return id is string && exists(/databases/$(database)/documents/clusters/$(id)); }
    function validPhone(p) { return p is string && p.size() <= 10 && (p.size() == 0 || p.matches('^0[0-9]{8,9}$')); }

    match /clusters/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /branches/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'clusterId', 'phone', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'clusterId', 'phone', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // ---------- הגדרות: רשימות וספים. כולם קוראים, רק מנהל משנה. ----------
    match /settings/{key} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // כל השאר חסום עד שייבנה
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
