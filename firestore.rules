rules_version = '2';

// כללי האבטחה של המערכת (אפיון סעיף 11 ו-13). ההרשאות נאכפות כאן, בצד השרת – לא רק בממשק.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // מנהל המערכת הקבוע – תמיד יכול להיכנס ולאשר. נדרש מייל מאומת (כניסה עם Google).
    function bootEmail() { return 'alonberger16@gmail.com'; }
    function isBoot() {
      return signedIn() && request.auth.token.email == bootEmail() && request.auth.token.email_verified == true;
    }

    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(myPath()) && get(myPath()).data.status == 'active'; }
    function isAdmin() { return isBoot() || (isActive() && get(myPath()).data.role == 'admin'); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // בקשת הצטרפות: רק לעצמך, במצב "ממתין" ובתפקיד "משתמש". מנהל המערכת הקבוע נוצר ישר כפעיל.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.status == 'pending' && request.resource.data.role == 'user')
          || (isBoot() && request.resource.data.status == 'active' && request.resource.data.role == 'admin')
        );

      allow update: if
        // משתמש על עצמו: רק זמן כניסה אחרונה
        (request.auth.uid == uid && onlyChanges(['lastLogin']))
        // משתמש שנמחק ונכנס שוב: בקשה חדשה במצב "ממתין"
        || (request.auth.uid == uid
            && resource.data.status == 'deleted'
            && request.resource.data.status == 'pending'
            && request.resource.data.role == 'user'
            && onlyChanges(['status', 'role', 'requestedAt', 'name', 'lastLogin', 'rejectReason']))
        // מנהל: הכל – חוץ מהשבתה, מחיקה או הורדת תפקיד של מנהל המערכת הקבוע
        || (isAdmin() && !(resource.data.email == bootEmail()
            && (request.resource.data.status != 'active' || request.resource.data.role != 'admin')));

      // אין מחיקה פיזית – רק מצב "נמחק"
      allow delete: if false;
    }

    // יומן פעולות: אפשר רק להוסיף. אף אחד, כולל מנהל, לא עורך ולא מוחק.
    match /auditLog/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isActive();
      allow update, delete: if false;
    }

    // ---------- סניפים ואשכולות (אפיון 6.10): כל משתמש פעיל מוסיף ועורך. אין מחיקה – רק "לא פעיל". ----------
    function validName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 60; }
    function stampedByMe(d) { return d.updatedBy == request.auth.uid; }
    function clusterExists(id) { return id is string && exists(/databases/$(database)/documents/clusters/$(id)); }
    function validPhone(p) { return p is string && p.size() <= 10 && (p.size() == 0 || p.matches('^0[0-9]{8,9}$')); }

    match /clusters/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /branches/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'clusterId', 'phone', 'active', 'createdAt', 'createdBy']);
      allow update: if isActive()
        && validName(request.resource.data)
        && clusterExists(request.resource.data.clusterId)
        && validPhone(request.resource.data.phone)
        && request.resource.data.active is bool
        && stampedByMe(request.resource.data)
        && onlyChanges(['name', 'clusterId', 'phone', 'active', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // ---------- לקוחות (אפיון 6.5, 12, 13) ----------
    // שדות טקסט חופשי לא מקבלים רצף של 13 ספרות ומעלה – כדי שאיש לא ירשום מספר כרטיס אשראי
    function noCard(s) { return s is string && s.size() <= 2000 && !s.matches('.*[0-9]{13,}.*'); }
    function taxPath(t) { return /databases/$(database)/documents/taxIds/$(t); }
    function validCustomer(d, cid) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.type in ['regular', 'occasional']
        && d.status in ['active', 'inactive', 'merged']
        && d.taxId is string && d.taxId.size() <= 9
        && (d.taxId == '' || (existsAfter(taxPath(d.taxId)) && getAfter(taxPath(d.taxId)).data.customerId == cid))
        && d.paymentMethod is string
        && d.accountPhone is string && d.accountPhone.size() <= 10
        && d.poRequired is bool
        && noCard(d.instructions) && noCard(d.billingInstructions)
        && d.contacts is list && d.contacts.size() <= 30
        && d.addresses is list && d.addresses.size() <= 30
        && d.customPrices is list && d.customPrices.size() <= 500;
    }

    match /customers/{cid} {
      allow read: if isActive();
      allow create: if isActive()
        && validCustomer(request.resource.data, cid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive()
        && validCustomer(request.resource.data, cid)
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']);
      allow delete: if false;

      match /activity/{aid} {
        allow read: if isActive();
        allow create: if isActive()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['note', 'call', 'followup']
          && noCard(request.resource.data.text) && request.resource.data.text.size() > 0;
        allow update, delete: if false;
      }
    }

    // ח.פ ייחודי: מסמך לכל ח.פ. יצירה כפולה נכשלת (נחשבת עדכון, ועדכון אסור).
    match /taxIds/{taxId} {
      allow read: if isActive();
      allow create: if isActive()
        && taxId.matches('^[0-9]{5,9}$')
        && request.resource.data.customerId is string
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.taxId == taxId;
      // שחרור ח.פ רק כשהלקוח שלו עובר לח.פ אחר באותה פעולה
      allow delete: if isActive()
        && getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.taxId != taxId;
      allow update: if false;
    }

    // ---------- מחירונים (אפיון 6.7) ----------
    match /priceLists/{pid} {
      allow read: if isActive();
      allow create, update: if isActive()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['shared', 'unique']
        && request.resource.data.active is bool
        && request.resource.data.items is list && request.resource.data.items.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------- הגדרות: רשימות וספים. כולם קוראים, רק מנהל משנה. ----------
    match /settings/{key} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // כל השאר חסום עד שייבנה
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
